relationship OneToOne {
  AppUser{user(login)} to User with builtInEntity
  EconomicActivity{agriculturalActivity} to AgriculturalActivity{economicActivity}
  EconomicActivity{livestockActivity} to LivestockActivity{economicActivity}
  EconomicActivity{aquacultureActivity} to AquacultureActivity{economicActivity}
  Member{individualMember} to IndividualMember{member}
  Member{organizationMember} to OrganizationMember{member}
  Member{socialProfile} to SocialProfile{member}
  Member{professionalProfile} to ProfessionalProfile{member}
}
relationship ManyToOne {
  AgriculturalActivity{location(name)} to Location
  AgriculturalProduction{agriculturalActivity} to AgriculturalActivity{productions}
  AgriculturalProduction{crop(name)} to Crop
  AgriculturalProduction{cropVariety(name)} to CropVariety
  AquacultureActivity{location(name)} to Location
  AquacultureActivity{aquaticSpecies(name)} to AquaticSpecies
  AquacultureProduction{aquacultureActivity} to AquacultureActivity{productions}
  AuditLog{appUser} to AppUser
  BranchUser{appUser} to AppUser
  BranchUser{branch(name)} to CooperativeBranch
  BranchUser{role(name)} to CooperativeRole
  CooperativeBranch{cooperative(name)} to Cooperative
  CooperativeBranch{location(name)} to Location
  CooperativeUser{appUser} to AppUser
  CooperativeUser{cooperative(name)} to Cooperative
  CooperativeUser{role(name)} to CooperativeRole
  CropVariety{crop(name)} to Crop
  EconomicActivity{member(memberNumber)} to Member
  EconomicActivity{activityType(name)} to EconomicActivityType
  EconomicActivity{location(name)} to Location
  FamilyMember{member(memberNumber)} to Member
  IdentityDocument{member(memberNumber)} to Member
  LivestockActivity{location(name)} to Location
  LivestockActivity{livestockType(name)} to LivestockType
  LivestockProduction{livestockActivity} to LivestockActivity{productions}
  Location{parent(name)} to Location
  Member{cooperative(name)} to Cooperative
  Member{branch(name)} to CooperativeBranch
  MemberDocument{member(memberNumber)} to Member
  MemberDocument{uploadedBy} to AppUser
  MembershipApplication{member(memberNumber)} to Member
  MembershipApplication{cooperative(name)} to Cooperative
  MembershipApplication{branch(name)} to CooperativeBranch
  NumberSequence{cooperative(name)} to Cooperative
}
relationship ManyToMany {
  CooperativeRole{permissions(code)} to Permission{roles}
}

