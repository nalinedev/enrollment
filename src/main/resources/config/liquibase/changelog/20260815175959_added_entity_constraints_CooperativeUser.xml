    <!--
        Added the constraints for entity CooperativeUser.
    -->
    <changeSet id="20260815175959-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="app_user_id"
                                 baseTableName="cooperative_user"
                                 constraintName="fk_cooperative_user__app_user_id"
